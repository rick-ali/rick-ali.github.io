---
import site from '../data/site.json';
import { resourceHref } from '../lib/content';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const links = [
  { label: 'Email', icon: 'email', url: `mailto:${site.email}` },
  ...site.socials,
  ...(site.cvUrl ? [{ label: 'CV', icon: 'document', url: resourceHref(site.cvUrl) }] : []),
];
const icons: Record<string, string> = {
  email: 'M3 5h18v14H3z M3 6l9 7 9-7',
  scholar: 'M2 9l10-6 10 6-10 6z M6 12v6c4 3 8 3 12 0v-6 M22 9v8',
  github: 'M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-3c3 0 6-1 6-6a4.5 4.5 0 0 0-1-3c.3-1 .3-2 0-3 0 0-1 0-3 1a11 11 0 0 0-8 0C6 3 5 3 5 3c-.3 1-.3 2 0 3a4.5 4.5 0 0 0-1 3c0 5 3 6 6 6a3.5 3.5 0 0 0-1 3v4',
  document: 'M5 3h9l5 5v13H5z M14 3v6h5 M8 13h8 M8 17h6',
  linkedin: 'M3 3h18v18H3z M7 10v7 M7 7v.1 M11 17v-7 M11 13c0-4 6-4 6 0v4',
  twitter: 'M23.954 4.57a10 10 0 0 1-2.825.775 4.958 4.958 0 0 0 2.163-2.723 9.99 9.99 0 0 1-3.127 1.195 4.92 4.92 0 0 0-8.384 4.482A13.96 13.96 0 0 1 1.64 3.162a4.92 4.92 0 0 0 1.523 6.563 4.9 4.9 0 0 1-2.229-.616v.062a4.923 4.923 0 0 0 3.946 4.827 4.93 4.93 0 0 1-2.224.084 4.93 4.93 0 0 0 4.6 3.42A9.87 9.87 0 0 1 0 19.54a13.94 13.94 0 0 0 7.548 2.212c9.057 0 14.01-7.503 14.01-14.01 0-.213-.005-.425-.014-.636a10.01 10.01 0 0 0 2.46-2.548z',
  link: 'M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2 M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2',
};
---
<div class:list={['profile-links', { compact }]} role="group" aria-label="Contact and profiles">
 {links.map(link => <a href={link.url} aria-label={link.label} title={link.label}>
  <svg viewBox="0 0 24 24" width="25" height="25" fill={link.icon === 'twitter' ? 'currentColor' : 'none'} stroke={link.icon === 'twitter' ? 'none' : 'currentColor'} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[link.icon] ?? icons.link} /></svg>
 </a>)}
</div>
