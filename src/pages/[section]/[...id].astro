---
import { render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadContent, href, resourceHref, longDate } from '../../lib/content';
export async function getStaticPaths() {
  const content = await loadContent();
  return Object.values(content).flat().map(entry => ({ params: { section: entry.collection, id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'research' | 'teaching' | 'talks'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const sectionName = { research: 'Research', teaching: 'Teaching', talks: 'Talks' }[entry.collection];
---
<SiteLayout title={entry.data.title} description={entry.data.summary} section={entry.collection}>
 <article class="detail-page">
  <a class="text-link back-link" href={href(`${entry.collection}/`)}>← {sectionName}</a>
  <div class="eyebrow">{entry.collection === 'research' ? `${entry.data.venue} · ${entry.data.year}` : entry.collection === 'teaching' ? `${entry.data.role} · ${entry.data.period}` : `${entry.data.kind} · ${longDate(entry.data.date)}`}</div>
  <h1>{entry.data.title}</h1>
  {entry.collection === 'research' && <p class="detail-meta">{entry.data.authors.join(', ')}</p>}
  {entry.collection === 'teaching' && <p class="detail-meta">{entry.data.institution}</p>}
  {entry.collection === 'talks' && <p class="detail-meta">{entry.data.event} · {entry.data.location}</p>}
  {entry.collection !== 'research' && <p class="detail-summary">{entry.data.summary}</p>}
  {entry.data.links.length > 0 && <nav class="resource-links" aria-label="Resources">{entry.data.links.map(link => <a href={resourceHref(link.url)}>{link.label} <span aria-hidden="true">↗</span></a>)}</nav>}
  {entry.collection === 'research' && entry.data.image && <figure class="paper-figure">
   <a href={resourceHref(entry.data.image)} target="_blank" rel="noopener"><img src={resourceHref(entry.data.image)} alt={entry.data.imageAlt} width="1000" height="500" /></a>
  </figure>}
  {entry.collection === 'research' ? <section class="prose paper-abstract" aria-labelledby="abstract-heading"><h2 id="abstract-heading">Abstract</h2><Content /></section> : <div class="prose"><Content /></div>}
 </article>
</SiteLayout>
