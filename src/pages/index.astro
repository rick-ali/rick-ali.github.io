---
import SiteLayout from '../layouts/SiteLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ResearchCard from '../components/ResearchCard.astro';
import TeachingList from '../components/TeachingList.astro';
import TalkList from '../components/TalkList.astro';
import site from '../data/site.json';
import { loadContent, href, resourceHref } from '../lib/content';
const content = await loadContent();
const research = content.research.slice(0, site.homepagePublicationCount);
const teaching = content.teaching.filter(entry => entry.data.featured);
const talks = content.talks;
---
<SiteLayout>
 <section class="about" aria-labelledby="about-heading">
  <div class="profile">
   <img class="portrait" src={resourceHref(site.profile.portrait)} alt={site.profile.portraitAlt} width="280" height="280" fetchpriority="high" />
   <p class="profile-name">{site.name}</p>
   <p class="profile-role">{site.profile.role}</p>
   <SocialLinks />
  </div>
  <div class="biography">
   <h1 id="about-heading">{site.profile.greeting} <span class="greeting-name">{site.profile.firstName}</span></h1>
   {site.profile.biography.map(paragraph => <p>{paragraph}</p>)}
   {site.education.length > 0 && <section class="education" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <ul>{site.education.map(entry => <li>
     <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9l10-6 10 6-10 6z M6 12v6c4 3 8 3 12 0v-6 M22 9v8" /></svg>
     <div><span class="education-degree">{entry.degree}</span><span class="education-institution">{entry.institution}{entry.period && <> <span aria-hidden="true">·</span> {entry.period}</>}</span></div>
    </li>)}</ul>
   </section>}
  </div>
 </section>
 <div class="entry-points" aria-label="Explore my work">
  <a href="#research"><span>Research</span><span class="jump-arrow" aria-hidden="true">↗</span><small>Questions, methods, discoveries</small></a>
  <a href="#teaching"><span>Teaching</span><span class="jump-arrow" aria-hidden="true">↗</span><small>Courses & shared understanding</small></a>
  <a href="#talks"><span>Talks</span><span class="jump-arrow" aria-hidden="true">↗</span><small>Seminars, workshops & ideas</small></a>
 </div>
 <section id="research" aria-labelledby="research-heading"><div class="section-head"><div><h2 id="research-heading">{site.researchHeading}</h2></div><a class="text-link" href={href('research/')}>All publications ↗</a></div><div class="publication-list">{research.map(entry => <ResearchCard entry={entry} />)}</div>{!research.length && <p class="empty-state">Explore the research page for publications.</p>}</section>
 <div class="teaching-talks">
  <section id="talks" aria-labelledby="talks-heading"><div class="section-head"><div><h2 id="talks-heading">{site.talksHeading}</h2></div></div><TalkList entries={talks} showImages /><a class="text-link section-more" href={href('talks/')}>Talks ↗</a></section>
  <section id="teaching" aria-labelledby="teaching-heading"><div class="section-head"><div><h2 id="teaching-heading">{site.teachingHeading}</h2></div></div><TeachingList entries={teaching} /><a class="text-link section-more" href={href('teaching/')}>Teaching ↗</a></section>
 </div>
</SiteLayout>
